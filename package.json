{
  "name": "uaemcp",
  "version": "1.32.0",
  "description": "Open Emirates Intelligence on Bun — official UAE open data over MCP.",
  "author": "Ahmed Morsy <vacrom414@gmail.com>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "uaemcp": "src/index.ts"
  },
  "exports": {
    ".": "./src/client.ts",
    "./server": "./src/server.ts",
    "./connectors": "./src/connectors.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts http",
    "start": "bun src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "fflate": "0.8.3",
    "ipaddr.js": "2.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
