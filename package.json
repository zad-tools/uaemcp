{
  "name": "uaemcp",
  "version": "1.75.1",
  "description": "Open Emirates Intelligence on Bun — official UAE open data over MCP.",
  "author": "Ahmed Morsy <vacrom414@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zad-tools/uaemcp.git"
  },
  "homepage": "https://uaemcp.zad.tools",
  "bugs": "https://github.com/zad-tools/uaemcp/issues",
  "license": "MIT",
  "type": "module",
  "bin": {
    "uaemcp": "src/index.ts"
  },
  "exports": {
    ".": "./src/client.ts",
    "./server": "./src/server.ts",
    "./connectors": "./src/connectors.ts"
  },
  "files": [
    "src",
    "docs/*.md",
    "docs/*.json",
    "examples",
    "templates",
    "sdk/csharp/*.cs",
    "sdk/csharp/*.csproj",
    "sdk/go/*.go",
    "sdk/go/go.mod",
    "sdk/java/pom.xml",
    "sdk/java/src/**/*.java",
    "sdk/python/pyproject.toml",
    "sdk/python/uaemcp/*.py",
    "sdk/rust/Cargo.toml",
    "sdk/rust/src/**/*.rs",
    ".vscode/uaemcp.code-snippets",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts http",
    "start": "bun src/index.ts",
    "test": "for file in test/*.test.ts; do bun test \"$file\" || exit 1; done",
    "test:coverage": "bun test --coverage --max-concurrency=1",
    "benchmark": "bun scripts/benchmark.ts",
    "typecheck": "bun x --bun tsc --noEmit",
    "check": "bun run check:security && bun run typecheck && bun run test && bun run check:tools && bun run check:sdks && bun run check:package",
    "check:security": "bun audit",
    "generate:sdks": "bun scripts/generate-sdks.ts",
    "check:sdks": "bun scripts/generate-sdks.ts --check",
    "generate:tools": "bun scripts/generate-tool-catalog.ts",
    "check:tools": "bun scripts/generate-tool-catalog.ts --check",
    "check:package": "bun scripts/check-package.ts",
    "prepublishOnly": "bun run check && bun run benchmark"
  },
  "dependencies": {
    "@maplibre/geojson-vt": "6.1.1",
    "@maplibre/vt-pbf": "4.3.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "fflate": "0.8.3",
    "ipaddr.js": "2.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@types/bun": "1.3.14",
    "@types/geojson": "7946.0.16",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
