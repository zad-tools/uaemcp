{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["bun"],
    "resolveJsonModule": true,
    "paths": {
      "@open-emirates/contracts": ["./packages/contracts/src/index.ts"],
      "uaemcp/cli": ["./src/index.ts"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "packages/**/*.ts", "test/**/*.ts"]
}
