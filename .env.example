# ── Open Emirates Intelligence — configuration ───────────────────────────────
# Copy to `.env` and adjust. Never commit the real `.env`.

# Write-tool authentication.
# When UAEMCP_WRITE_TOKEN is set, mutating tools/endpoints (add source, run sync)
# require it via the `X-API-Key` header or the tool's `token` argument.
# Leave empty to DISABLE writes entirely (read-only server, the safe default).
UAEMCP_WRITE_TOKEN=

# HTTP transport bind (only used by `uaemcp http`).
UAEMCP_HOST=127.0.0.1
UAEMCP_PORT=8080

# Outbound fetch behaviour.
UAEMCP_HTTP_TIMEOUT=8.0          # per-request total timeout (seconds)
UAEMCP_HEALTH_TIMEOUT=5.0        # per-source health probe timeout (seconds)
UAEMCP_CACHE_TTL=300             # response/health cache TTL (seconds)
UAEMCP_STALE_WHILE_REVALIDATE=1800 # serve cached health while refreshing (seconds)
UAEMCP_MAX_RESPONSE_BYTES=5242880  # 5 MiB cap on any fetched body

# MCP tool surface. `full` preserves all tools. `core` exposes six agent-first
# entry points; `research` and `geo` add their relevant specialist tools.
UAEMCP_TOOL_PROFILE=full

# SSRF guard. Blocking private/loopback/link-local/metadata IPs is ALWAYS on.
# Set to 1 only for local development against localhost sources (unsafe in prod).
UAEMCP_ALLOW_PRIVATE_HOSTS=0

# Browser-like UA so government portals with bot-mitigation don't hang the probe.
UAEMCP_USER_AGENT=Mozilla/5.0 (compatible; UAEMCP/0.1; +https://github.com/)

# Streamable-HTTP DNS-rebinding protection. Behind a reverse proxy the app sees
# the PUBLIC Host header, so allow-list it here (comma-separated) or /mcp returns
# 421. Include localhost variants for local health checks. Leave empty for
# stdio-only / localhost-only use.
UAEMCP_ALLOWED_HOSTS=
UAEMCP_ALLOWED_ORIGINS=
UAEMCP_RATE_LIMIT_PER_MINUTE=120

# Durable Bun SQLite database for health history and dataset snapshots.
UAEMCP_DATABASE_PATH=data/uaemcp.sqlite
UAEMCP_HEALTH_RETENTION=10000
UAEMCP_SNAPSHOT_RETENTION=30

# Optional built-in snapshot scheduler. Disabled unless both interval and targets
# are set. Targets use `source_id` or `source_id@dataset_id`, comma-separated.
UAEMCP_SNAPSHOT_INTERVAL_MINUTES=0
UAEMCP_SNAPSHOT_TARGETS=
UAEMCP_SNAPSHOT_LIMIT=100

# Optional Policy Evidence Watch. The hosted deployment checks the five audited
# official pages once per day and retains hashes plus short excerpts only.
UAEMCP_POLICY_WATCH_PATH=data/policy-watch.json
UAEMCP_POLICY_WATCH_INTERVAL_MINUTES=0
UAEMCP_POLICY_WATCH_RETENTION=30

# ── Key-gated official sources (optional) ────────────────────────────────────
# A few official portals publish a machine API behind a free registered
# developer key. Those sources are catalogued with `requires_api_key: true` and
# an `api_docs` link; they return records only once you supply a key (records
# are never fabricated). Register with the provider, then set the key here.
# Leave empty to keep those sources as discovery-only.
#
#   Dubai Pulse (DLD real-estate transactions, DEWA, RTA) — https://www.dubaipulse.gov.ae/
# UAEMCP_DUBAIPULSE_API_KEY=
# UAEMCP_DUBAIPULSE_API_SECRET=
#
#   Abu Dhabi Open Data (registered-developer REST API) — https://data.abudhabi/developers
# UAEMCP_ABUDHABI_API_KEY=

# --- Open Emirates Pro (paid quota layer; leave unset for a fully free server) ---
# SaaSpress control plane on the ZAD STACK store:
SAASPRESS_BASE_URL=
SAASPRESS_APP_ID=
SAASPRESS_KEY_ID=
SAASPRESS_SECRET=
# Shared secret for deriving/verifying oe_ API keys (same value on the storefront):
UAEMCP_PRO_KEY_SECRET=
# Optional overrides:
# UAEMCP_PRO_METRIC=mcp_calls
# UAEMCP_PRO_DATABASE_PATH=data/pro-usage.sqlite
